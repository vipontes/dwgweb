{
  "name": "dwg-viewer",
  "version": "0.1.0",
  "description": "Vue 3 component that renders DXF/DWG files via a WebAssembly build of dwgviewer's Qt-free parser (libdxfrw + dwg_document) and a Canvas2D port of its renderer.",
  "type": "module",
  "main": "./dist/dwg-viewer.js",
  "module": "./dist/dwg-viewer.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/dwg-viewer.js"
    }
  },
  "files": [
    "dist",
    "resources"
  ],
  "scripts": {
    "build:wasm": "bash wasm/build.sh release",
    "build": "vite build && vue-tsc -p tsconfig.build.json",
    "dev": "vite build --watch",
    "typecheck": "vue-tsc --noEmit"
  },
  "peerDependencies": {
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.1.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.9",
    "vue": "^3.5.12",
    "vue-tsc": "^2.1.6"
  }
}
